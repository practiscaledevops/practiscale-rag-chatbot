# ---- The Brain (RAG back-office) ----
# Base URL of the deployed Brain and the SCOPED key this chatbot is allowed to use.
# The key is used SERVER-SIDE ONLY (in src/app/api/chat) and never sent to the browser.
BRAIN_API_URL=http://localhost:3000
BRAIN_API_KEY=psk_live_...

# ---- Chatbot's own database (users, chat history, projects) ----
# Separate Supabase project from the Brain.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-CHATBOT-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App ----
APP_SECRET=change-me-to-a-long-random-string
# Default model tier the chatbot requests from the Brain: fast | recommended | max
DEFAULT_MODEL_TIER=recommended
